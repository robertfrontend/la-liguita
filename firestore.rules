rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar autenticación
    function isAuthenticated() {
      return request.auth != null;
    }

    // Colección de Usuarios
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Colección de Torneos (Multi-Tier SaaS)
    match /tournaments/{tournamentId} {
      allow read: if true; // Lectura pública para fans y jugadores
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || 
        request.resource.data.ownerId == request.auth.uid
      );

      // Subcolección Partidos
      match /games/{gameId} {
        allow read: if true;
        allow write: if isAuthenticated();

        // Subcolección Play-by-Play (Solo Plan PRO)
        match /playByPlay/{eventId} {
          allow read: if true;
          allow write: if isAuthenticated();
        }
      }

      // Subcolecciones Equipos, Jugadores, Árbitros
      match /teams/{teamId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
      
      match /players/{playerId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      match /referees/{refereeId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // Colección Leagues (Compatibilidad Legacy)
    match /leagues/{leagueId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
      
      match /games/{gameId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
      
      match /players/{playerId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    match /early_access/{document=**} {
      allow create: if true;
    }
  }
}
