rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow unauthenticated users to join the waitlist
    match /early_access/{document=**} {
      allow create: if true;
    }

    // 1. Allow anyone to READ leagues (public pages needs this)
    // 2. Allow only authenticated users to WRITE (create/update leagues)
    match /leagues/{leagueId} {
      allow read: if true;
      allow write: if request.auth != null;

      // 🚨 Subcollections must also explicitly allow public read!
      
      // Allow public to read games history
      match /games/{gameId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      
      // Allow public to read player stats/leaderboard
      match /players/{playerId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
