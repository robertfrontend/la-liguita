rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // PERMITIR TODO EL READ PÚBLICO (Incluyendo perfiles)
    match /{document=**} {
      allow read: if true;
    }

    // ESCRITURA: Solo usuarios autenticados para su propio perfil
    match /users/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Ligas y subcolecciones: Escritura para usuarios autenticados
    match /leagues/{leagueId} {
      allow write: if request.auth != null;
      
      match /games/{gameId} {
        allow write: if request.auth != null;
      }
      
      match /players/{playerId} {
        allow write: if request.auth != null;
      }
    }

    match /early_access/{document=**} {
      allow create: if true;
    }
  }
}
